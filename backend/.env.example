# =============================================
# Smart Polling Booth Officer Allocation System
# Backend environment variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# =============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/polling_system

# JWT authentication
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_EXPIRES_IN=24h

# Default administrator (seeded into MongoDB on first server start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------------- SMS Provider ----------------
# Allowed values: mock | http
# mock  = logs the message and simulates delivery (no external call) - DEFAULT
# http  = posts the message to SMS_PROVIDER_API_URL using a generic JSON body
#         (works with MSG91, TextLocal, Twilio proxy adapters, etc.)
SMS_PROVIDER=mock

# Below settings are ONLY used when SMS_PROVIDER=http
SMS_PROVIDER_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
# Optional headers the provider needs as JSON, e.g. {"X-Auth-Token":"abc"}
SMS_EXTRA_HEADERS={}
# ---------------- Allocation engine ----------------
DEFAULT_REQUIRED_OFFICERS=4
STRICT_ADDRESS_MODE=true
ALLOW_FALLBACK_ALLOCATION=true
