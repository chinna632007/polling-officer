// Frontend environment variables
// Vite exposes vars prefixed with VITE_ to client code via import.meta.env

# Base URL of the backend API. Leave blank to use the Vite dev proxy
# (vite.config.js proxies /api, /auth and /api-docs to the backend).
VITE_API_BASE_URL=

# Port of the backend used by the dev proxy. Must match PORT in backend/.env
# (default 5000).
VITE_PROXY_TARGET=http://localhost:5000
